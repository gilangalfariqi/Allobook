{
  "name": "@allobook/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js --packages=external && esbuild prisma/seed.ts --bundle --platform=node --target=node20 --outfile=dist/seed.js --packages=external",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node dist/seed.js",
    "embeddings:backfill": "ts-node scripts/backfill-embeddings.ts"
  },
  "dependencies": {
    "@allobook/shared-types": "workspace:*",
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.2.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@prisma/client": "^5.11.0",
    "@sentry/node": "^8.0.0",
    "argon2": "^0.31.2",
    "bullmq": "^5.4.2",
    "dotenv": "^17.4.2",
    "fastify": "^4.26.2",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "meilisearch": "^0.39.0",
    "nodemailer": "^6.9.13",
    "openai": "^7.10.0",
    "pino": "^8.19.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@allobook/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.14",
    "esbuild": "^0.28.2",
    "ioredis": "^5.11.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.4.0"
  },
  "prisma": {
    "seed": "node dist/seed.js"
  }
}
